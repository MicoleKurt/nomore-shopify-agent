# Copy to .env and fill in. Never commit .env.

# Your own Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Shopify dev store, e.g. my-test-store.myshopify.com
SHOPIFY_STORE=your-dev-store.myshopify.com

# Admin API access: use ONE of these two options.
# A) Dev Dashboard app (how new apps are created since 2026): the script swaps these for a 24h token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# B) A static token from an older custom app (shpat_...). If set, it wins.
SHOPIFY_ADMIN_TOKEN=

# Dev stores sit behind a storefront password; the preview screenshots need it.
SHOPIFY_STORE_PASSWORD=

# How theme files are uploaded: auto | admin-api | cli
# auto = try the Admin API, switch to `shopify theme push` if Shopify refuses (write_themes needs an exemption).
THEME_WRITER=auto
# Password from the free "Theme Access" app, used by the CLI route (optional if the CLI is logged in).
SHOPIFY_THEME_PASSWORD=

# Optional: numeric id of a specific theme. Blank = the store's main theme.
SHOPIFY_THEME_ID=

SOURCE_URL=https://try-nomore.com/products/nomorecolds-red-light-therapy-colds-sinusitis
MODEL=claude-sonnet-5-5
# Hard stop for the whole run, in USD.
MAX_BUDGET_USD=4
